OPENROUTER_API_KEY=your-openrouter-key
# comma-separated, tried in order (tool-calling capable models)
OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# reasoning models: 'off' (default, fast, reliable structured output) or 'on'
OPENROUTER_REASONING=off
# crew (default) | single (original one-judge loop, kept as the A/B baseline)
AGENT_MODE=crew
# live | record (live + save to data/cassette.json) | replay (offline, deterministic)
LLM_MODE=live
# free-tier requests per minute the client will send
LLM_RPM=18
# optional per-tier model chains (default: OPENROUTER_MODELS)
# OPENROUTER_MODELS_FAST=...
# OPENROUTER_MODELS_STRONG=...
# reference $/1M tokens (in,out) used only to report what this call pattern would cost on paid models
PRICE_FAST=0.25,1.25
PRICE_STRONG=3,15
